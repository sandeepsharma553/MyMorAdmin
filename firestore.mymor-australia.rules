rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function userHostelId() { return isSignedIn() ? request.auth.token.hostelId : null; }
    function hostelActive(hid) {
      return get(/databases/$(database)/documents/hostel/$(hid)).data.active == true;
    }
    // ── Restaurant Groups (multi-venue restaurant clients) ──
    function rgHasEmp() {
      return isSignedIn() && exists(/databases/$(database)/documents/employees/$(request.auth.uid));
    }
    function rgEmp() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data;
    }
    function rgIsSuper() {
      return isSignedIn() && (
        request.auth.token.role == 'superadmin' ||
        request.auth.token.type == 'superadmin' ||
        (rgHasEmp() && rgEmp().type == 'superadmin')
      );
    }
    function rgIsGroupMember(groupId) { return rgHasEmp() && rgEmp().groupId == groupId; }
    function rgGroupRoleIn(gid, roles) {
      return rgHasEmp() && rgEmp().groupId == gid && (rgEmp().groupRole in roles);
    }
    function rgIsGroupAdmin(gid)   { return rgGroupRoleIn(gid, ['owner', 'storeAdmin']); }
    function rgCanManageStaff(gid) { return rgGroupRoleIn(gid, ['owner', 'storeAdmin', 'manager']); }
    // Leave accrual config (Phase 2, Aug 2026): OWNER only — narrower than
    // rgIsGroupAdmin because remapping an accrual label silently changes who accrues.
    function rgIsGroupOwner(gid)   { return rgGroupRoleIn(gid, ['owner']); }
    function rgIsGroupUser() { return rgHasEmp() && rgEmp().get('groupId', null) != null; }
    function rgStaff(gid, sid) { return get(/databases/$(database)/documents/restaurantGroups/$(gid)/staff/$(sid)).data; }

    function rgIsOwnStaff(gid, sid) {
      return sid != null
        && exists(/databases/$(database)/documents/restaurantGroups/$(gid)/staff/$(sid))
        && (rgStaff(gid, sid).adminUid == request.auth.uid
            || (request.auth.token.email != null && rgStaff(gid, sid).get('email', '') == request.auth.token.email));
    }
    // NEW: can this signed-in user approve leave? owner/storeAdmin always, OR an
    // explicit permissions.leave == 'approve' grant on their employees doc.
    function rgCanApproveLeave(gid) {
      return rgIsGroupAdmin(gid)
        || (rgHasEmp() && rgEmp().groupId == gid
            && rgEmp().get('permissions', {}).get('leave', '') == 'approve');
    }
    // Mirrors rgCanApproveLeave: owner/storeAdmin always, OR an explicit
    // permissions.availability == 'approve' grant on their employees doc.
    function rgCanApproveAvailability(gid) {
      return rgIsGroupAdmin(gid)
        || (rgHasEmp() && rgEmp().groupId == gid
            && rgEmp().get('permissions', {}).get('availability', '') == 'approve');
    }
    // Group-chat member editing (Job 5): owner/storeAdmin always, OR an explicit
    // permissions.messages == 'approve' grant (set per person in User Management —
    // same consume-approve pattern as leave/availability, never seeded by default).
    function rgCanEditChatMembers(gid) {
      return rgIsGroupAdmin(gid)
        || (rgHasEmp() && rgEmp().groupId == gid
            && rgEmp().get('permissions', {}).get('messages', '') == 'approve');
    }
    // Notifications (Job 6f): who may SEND — write authored/broadcast notifications
    // and manage schedules. Written the same way as rgCanApproveLeave (the template),
    // but edit-or-above: sending is an edit-level act, and an owner-granted 'approve'
    // must not silently LOSE the ability edit carries.
    function rgCanSendNotifications(gid) {
      return rgIsGroupAdmin(gid)
        || (rgHasEmp() && rgEmp().groupId == gid
            && rgEmp().get('permissions', {}).get('notifications', '') in ['edit', 'approve']);
    }
     match /restaurantGroups/{groupId} {

      allow read:   if rgIsSuper() || rgIsGroupMember(groupId);
      allow create: if rgIsSuper();
      allow update, delete: if rgIsSuper() || rgIsGroupAdmin(groupId);
      match /staff/{staffId} {
        allow read:  if rgIsSuper() || rgIsGroupMember(groupId);
        allow write: if rgIsSuper() || rgCanManageStaff(groupId);
        // Staff Directory self-service (Jul 2026): a staffer may update their OWN
        // phone number on the public staff doc — hasOnly() rejects any other key.
        allow update: if rgIsOwnStaff(groupId, staffId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['phone', 'updatedAt']);
        // 🔒 Sensitive payroll (TFN / bank / super) — owner/storeAdmin only.
        // Phase 5b (revised Jul 2026): a staffer may READ their own private/details and
        // UPDATE their personal + money keys directly (the owner's decision, 30 Jul 2026
        // list: "it should just update and then send notification to admin"). The
        // whitelist below is hasOnly(), so ANY key not listed is rejected outright —
        // still excluding every employment term (classificationLevel, annualSalary,
        // hourlyRate, contractedHoursMin/Max and the retired contractedMinHours) and
        // `password`.
        match /private/details {
          allow read: if rgIsSuper() || rgIsGroupAdmin(groupId) || rgIsOwnStaff(groupId, staffId);
          allow create, delete: if rgIsSuper() || rgIsGroupAdmin(groupId);
          allow update: if rgIsSuper() || rgIsGroupAdmin(groupId)
            || (rgIsOwnStaff(groupId, staffId)
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['legalName', 'dob', 'address', 'contactEmail',
                               'tfn', 'superAccount', 'superUsi', 'bankBsb', 'bankAccount',
                               'updatedAt']));
        }
        // Any OTHER doc under private/ stays owner/storeAdmin-only.
        match /private/{doc=**} {
          allow read, write: if rgIsSuper() || rgIsGroupAdmin(groupId);
        }
        // Warning acknowledgements (owner list #4, Aug 2026): the staffer's "read &
        // acknowledged" tick for a warning on their record. Its own subcollection because
        // the staff doc's self-update stays phone-only — a staffer must never be able to
        // rewrite the records array itself. Doc id = the warning record id. Create-only
        // for the staffer (an ack can't be edited or retracted); managers/admins read the
        // tick state. The manager-witness ack lives ON the record entry (manager-tier
        // staff-doc write above covers it).
        match /acks/{recordId} {
          allow read: if rgIsSuper() || rgIsGroupMember(groupId);
          allow create: if rgIsSuper() || rgIsGroupAdmin(groupId)
            || (rgIsOwnStaff(groupId, staffId)
                && request.resource.data.keys().hasOnly(['type', 'ackAt', 'by']));
          allow update, delete: if rgIsSuper() || rgIsGroupAdmin(groupId);
        }
        // Phase 5b: payroll change requests (TFN / super / bank). The staffer submits;
        // owner/storeAdmin applies. These docs CONTAIN payroll values, so read is
        // owner/storeAdmin or the staffer themselves — NOT plain managers.
        // `fields` is whitelisted to the five money keys, so a crafted request cannot
        // smuggle a salary/rate change through the owner's Apply button.
        match /payrollChangeRequests/{reqId} {
          allow read: if rgIsSuper() || rgIsGroupAdmin(groupId) || rgIsOwnStaff(groupId, staffId);
          allow create: if rgIsSuper() || rgIsGroupAdmin(groupId)
            || (rgIsOwnStaff(groupId, staffId)
                && request.resource.data.status == 'pending'
                && request.resource.data.fields.keys()
                     .hasOnly(['tfn', 'superAccount', 'superUsi', 'bankBsb', 'bankAccount']));
          allow update, delete: if rgIsSuper() || rgIsGroupAdmin(groupId);
        }
        // Phase B: per-staff document history (uploads / renames / deletes / restores).
        // Carries FILE NAMES, which can themselves be sensitive ("final_warning.pdf") —
        // so this is NOT group-readable like auditLog. Owner/storeAdmin, or the staffer
        // themselves. Client writes are append-only; no edits, no deletes.
        match /docHistory/{entryId} {

          allow read: if rgIsSuper() || rgIsGroupAdmin(groupId) || rgIsOwnStaff(groupId, staffId);
          allow create: if rgIsSuper() || rgIsGroupAdmin(groupId);
          allow update, delete: if rgIsSuper();
        }
        // Per-staff acknowledgements — the staff member, or a manager/owner.
        match /acknowledgements/{version} {
          allow read:           if rgIsSuper() || rgCanManageStaff(groupId) || rgIsOwnStaff(groupId, staffId);
          allow create, update: if rgIsSuper() || rgCanManageStaff(groupId) || rgIsOwnStaff(groupId, staffId);
          allow delete:         if rgIsSuper() || rgCanManageStaff(groupId);
        }
        // ── Leave accrual ledger (NES) — SERVER-WRITTEN ONLY (Phase 2, Aug 2026) ──
        // leaveLedger/ holds the append-only accrual/deduction trail; leave/summary is
        // the one-doc balance read. BOTH are written EXCLUSIVELY by Admin-SDK Cloud
        // Functions, which BYPASS these rules — that is the ENTIRE write path. The
        // absence of any allow create/update/delete below is deliberate and
        // load-bearing: no client may ever write a ledger entry or summary.
        // Read: the staffer themselves + owner/storeAdmin. Plain managers DENIED
        // (a balance is payroll-adjacent — same posture as private/details above).
        match /leaveLedger/{entryId} {
          allow read: if rgIsSuper() || rgIsGroupAdmin(groupId) || rgIsOwnStaff(groupId, staffId);
        }
        match /leave/{docId} {
          allow read: if rgIsSuper() || rgIsGroupAdmin(groupId) || rgIsOwnStaff(groupId, staffId);
        }
      }
      // ── Contract Generator (Documents module) — owner/storeAdmin only ──
      // Templates are seeded out-of-band (Admin SDK); the app only READS them.
      match /contractTemplates/{templateId} {
        allow read:  if rgIsSuper() || rgIsGroupAdmin(groupId);
        allow write: if rgIsSuper();
      }
      // Contract defaults live in a gated settings/ subcollection (NOT the group doc).
      match /settings/contractDefaults {
        allow read, write: if rgIsSuper() || rgIsGroupAdmin(groupId);
      }
      match /contracts/{contractId} {
         allow read, write: if rgIsSuper() || rgIsGroupAdmin(groupId);
      }
      match /settings/contractClassifications {
        allow read, write: if rgIsSuper() || rgIsGroupAdmin(groupId);
      }
      match /settings/legalEntities {
        allow read, write: if rgIsSuper() || rgIsGroupAdmin(groupId);
      }
      match /settings/publicHolidays {
        allow read:  if rgIsSuper() || rgIsGroupMember(groupId);
        allow write: if rgIsSuper() || rgIsGroupAdmin(groupId);
      }

      // Labour targets ($/hr + weekly revenue) — gated settings doc so staff can't read
      // them (the group doc is group-readable). Read: manager+ (labour % on Shift Planner).
      // Write: owner/storeAdmin only (managers are read-only).
      match /settings/labourTargets {
        allow read:  if rgIsSuper() || rgCanManageStaff(groupId);
        allow write: if rgIsSuper() || rgIsGroupAdmin(groupId);
      }
      // ── Leave accrual config (Phase 2, Aug 2026) — the ONLY owner-editable part of
      // accrual: classMap (employment-type label → fixed accrual class) and bucketMap
      // (leave-type label → fixed NES bucket). The classes, buckets and NES rates
      // themselves are platform constants in MyMorFunction/rgLeaveAccrual.js — never
      // configurable here, never rendered in Settings as numbers.
      // Write: OWNER ONLY (not storeAdmin — remapping a label silently changes who
      // accrues, so it carries the narrowest write in the group tree).
      // Read: owner/storeAdmin (the Settings UI). Functions read via the Admin SDK.
      match /settings/leaveAccrualConfig {
        allow read:  if rgIsSuper() || rgIsGroupAdmin(groupId);
        allow write: if rgIsSuper() || rgIsGroupOwner(groupId);
        // Append-only audit trail of map changes ({at, byUid, byName, field, label,
        // previous, next}): owner create-only, nobody edits or deletes. (A Phase 3
        // trigger will mirror this server-side; client-written history alone can be
        // skipped by a direct SDK write — stated boundary, not full enforcement.)
        match /history/{entryId} {
          allow read:   if rgIsSuper() || rgIsGroupAdmin(groupId);
          allow create: if rgIsSuper() || rgIsGroupOwner(groupId);
          allow update, delete: if rgIsSuper();
        }
      }
      match /venues/{venueId} {
        allow read, write: if rgIsSuper() || rgIsGroupMember(groupId);
        // Operational per-venue data (checklists, tempLogs, shifts, stations, equipment,
        // trainingModules/Assignments, checklistAssignments, kpis, performanceNotes, …) —
        // any group member. EXCLUDES leaveRequests and the cost/stock collections, which
        // each have their own tighter block below. (Firestore ORs overlapping matches, so
        // the only way to NARROW is to exclude here — same pattern as leaveRequests.)
        match /{coll}/{docId=**} {


          allow read, write: if (rgIsSuper() || rgIsGroupMember(groupId))
            && !(coll in ['leaveRequests', 'shifts', 'timeEntries', 'availability', 'stock', 'stockMovements', 'stocktakes', 'batches', 'production', 'orders', 'menuItems', 'performanceNotes', 'kpis']); // ⬅ ADDED 'performanceNotes', 'kpis'
        }
        // ── Stock / cost collections — manager+ ONLY (matches can('stock') =
        // owner/storeAdmin/manager; staff is stock:none). Holds cost, weighted-avg,
        // variance $, production cost. Server (rgSellOrder, Admin SDK) bypasses rules.
        match /stock/{docId=**}          { allow read, write: if rgIsSuper() || rgCanManageStaff(groupId); }
        match /stockMovements/{docId=**} { allow read, write: if rgIsSuper() || rgCanManageStaff(groupId); }
        match /stocktakes/{docId=**}     { allow read, write: if rgIsSuper() || rgCanManageStaff(groupId); }
        match /batches/{docId=**}        { allow read, write: if rgIsSuper() || rgCanManageStaff(groupId); }
        match /production/{docId=**}     { allow read, write: if rgIsSuper() || rgCanManageStaff(groupId); }
        // ── ADDED: Performance (HR records) — manager+ ONLY. The permission matrix says
        // owner=edit, storeAdmin/manager=view, staff=NONE. These previously rode the venue
        // catch-all at member read+WRITE, so every staff member could read — and rewrite —
        // warnings and coaching notes about anyone. Read+write are both manager+ here rather
        // than split: the matrix wants storeAdmin/manager read-only, but tightening writes
        // further needs the writers audited first. Excluding staff is the urgent half.

        match /performanceNotes/{docId=**} { allow read, write: if rgIsSuper() || rgCanManageStaff(groupId); }
        match /kpis/{docId=**}             { allow read, write: if rgIsSuper() || rgCanManageStaff(groupId); }
        // ── Per-venue MENU INSTANCES (template+instance model) — member-READ (POS/floor
        // need sellPrice/variants/86/availability), manager+ WRITE (no staff price-forging).
        // Mirrors the group-level menuItems gate. Server (rgSellOrder, Admin SDK) bypasses.
        match /menuItems/{docId=**} {
          allow read:  if rgIsSuper() || rgIsGroupMember(groupId);
          allow write: if rgIsSuper() || rgCanManageStaff(groupId);
        }
        // ── Orders (POS) — server-write-only, manager-read. Orders are created ONLY by
        // rgSellOrder (Admin SDK, bypasses rules) inside its stock transaction. No client
        // may write/forge an order. Managers+ may READ for the live-orders view.
        match /orders/{docId=**} {
          allow read: if rgIsSuper() || rgCanManageStaff(groupId);
          allow write: if false;
        }
        // ── CHANGED BLOCK ── approve/update now requires leave-approve permission
        // (owner/storeAdmin, or an explicit permissions.leave=='approve' grant),
        // matching the app's `approve` permission level. Submit-your-own unchanged.
        match /leaveRequests/{leaveId} {
          allow read:   if rgIsSuper() || rgIsGroupMember(groupId);
          allow create: if rgIsSuper() || rgCanManageStaff(groupId)
                        || (rgIsGroupMember(groupId) && rgIsOwnStaff(groupId, request.resource.data.staffId));
          allow update, delete: if rgIsSuper() || rgCanApproveLeave(groupId);
        }
        // ── END CHANGED BLOCK ──
        // ── Availability feature (kiosk clock + availability + assignment) ──
        // Roster (shifts): any group member READS; only managers+ WRITE. Closes the
        // previous open hole where any member could write any shift via the catch-all.
        match /shifts/{shiftId} {
          allow read:  if rgIsSuper() || rgIsGroupMember(groupId);
          allow write: if rgIsSuper() || rgCanManageStaff(groupId);
        }
        // Time clock: the kiosk is a SHARED terminal — the signed-in device account writes
        // on behalf of staff (identity is the in-app PIN, NOT auth.uid). So create/update are
        // group-member; delete is managers+. (Manager "approve" is an update by a manager.)

        match /timeEntries/{entryId} {

        allow read:   if rgIsSuper() || rgIsGroupMember(groupId);
          allow create: if rgIsSuper() || rgIsGroupMember(groupId);
          allow update: if rgIsSuper() || rgIsGroupMember(groupId);
          allow delete: if rgIsSuper() || rgCanManageStaff(groupId);
          match /breaks/{breakId} {
            allow read:  if rgIsSuper() || rgIsGroupMember(groupId);
            allow write: if rgIsSuper() || rgIsGroupMember(groupId);
          }
        }
        // Availability posting: shared-kiosk model — the device account posts on behalf of
        // PIN-identified staff, so create/update stay group-member. A non-approver may only
        // write status 'pending' (post / re-post resets review) or leave status unchanged;
        // setting accepted/rejected requires the availability-approve grant.
        // COUNTER-PROPOSE: a group member may also move a doc a manager set to 'proposed'
       // → 'accepted' or 'declined' (the staffer answering on the iPad). Bounded to that
        // exact stored→incoming transition, so it can't jump pending→accepted.
        match /availability/{availId} {
          allow read:   if rgIsSuper() || rgIsGroupMember(groupId);
          allow create: if rgIsSuper()
            || (rgIsGroupMember(groupId)
                && (request.resource.data.get('status', 'pending') == 'pending'
                    || rgCanApproveAvailability(groupId)));
          allow update: if rgIsSuper()
            || (rgIsGroupMember(groupId)
                && (request.resource.data.get('status', 'pending') == 'pending'
                    || request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending')
                    || rgCanApproveAvailability(groupId)
                    || (resource.data.get('status', '') == 'proposed'
                        && request.resource.data.get('status', '') in ['accepted', 'declined'])));
          allow delete: if rgIsSuper() || rgCanManageStaff(groupId);
        }
      }
      // ── Availability (Phase 3 — cluster-scoped, group-level, INFORMATIONAL-ONLY) ──
      // Staff post when they're free to a GROUP-level collection keyed
      // {staffId}_{clusterId}_{date}. No status / accept / reject / propose — the doc is

     // pure information; managers READ it and roster manually. This REPLACES the old
      // per-venue availability state machine under venues/, which is intentionally LEFT
      // in place (still readable) for the 14-day dual-read cutover, then removed in the
      // post-cutover cleanup along with the legacy read.
      match /availability/{availId} {
        allow read:           if rgIsSuper() || rgIsGroupMember(groupId);
        allow create, update: if rgIsSuper() || rgIsGroupMember(groupId);
        allow delete:         if rgIsSuper() || rgCanManageStaff(groupId);
      }
      // ── Stock / Menus / Supplier (Module #2) — group-level shared collections ──
      // Inventory / suppliers / POs: manager+ (cost & supplier-pricing data).
      // Menu / modifier groups: readable by group members (floor/POS need them); writes manager+.
      // Recipes: read tightened to manager+ (expose food-cost composition).
      match /inventoryItems/{itemId} {
        allow read, write: if rgIsSuper() || rgCanManageStaff(groupId);
      }
      match /menuItems/{menuItemId} {
        // ⚠ COST-FIELD TENSION (flagged): doc contains `cost`. Kept member-read so POS/
        // floor can read sellPrice/variants/modifierGroupIds. See review §2 for options.
        allow read:  if rgIsSuper() || rgIsGroupMember(groupId);
        allow write: if rgIsSuper() || rgCanManageStaff(groupId);
      }

      match /recipes/{recipeId} {
        // Read tightened to manager+: recipes reveal food-cost build (ingredient qty ×
        // inventory cost). No staff client screen reads them; POS deducts server-side.
        allow read:  if rgIsSuper() || rgCanManageStaff(groupId);
        allow write: if rgIsSuper() || rgCanManageStaff(groupId);
      }
      match /modifierGroups/{modId} {
        // Read was rgCanManageStaff — that denial made every POS item look like it had NO
        // modifiers for staff-tier users (both clients filter modifierGroupIds against this
        // collection), so required choices bypassed and paid add-ons vanished, silently, at
        // base price. Holds no cost data — only priceDelta, a price the POS already shows

         // the customer. Mirrors the menuItems gate. Write unchanged.
        allow read:  if rgIsSuper() || rgIsGroupMember(groupId);
        allow write: if rgIsSuper() || rgCanManageStaff(groupId);
      }
      match /suppliers/{supplierId} {
        // Read manager+ (supplier:view). Write owner/storeAdmin only (supplier:edit);
        // managers are view-only and don't edit the directory from the client.
        allow read:  if rgIsSuper() || rgCanManageStaff(groupId);
        allow write: if rgIsSuper() || rgIsGroupAdmin(groupId);
      }
      match /purchaseOrders/{poId} {
        // Write tightened to owner/storeAdmin (supplier:edit). Managers are
        // supplier:view and don't create/approve POs from the client; auto-draft
        // POs are written by the rgSellOrder CF (Admin SDK). Read unchanged at manager+.
        allow read:  if rgIsSuper() || rgCanManageStaff(groupId);
        allow write: if rgIsSuper() || rgIsGroupAdmin(groupId);
      }
      // ── Compliance & Award (your recent work) — read: members; write: manager+ ──
      match /awardRates/{awardCode} {
        allow read:  if rgIsSuper() || rgIsGroupMember(groupId);
        allow write: if rgIsSuper() || rgCanManageStaff(groupId);
      }
       match /compliance/{docId} {
        allow read:  if rgIsSuper() || rgIsGroupMember(groupId);
        allow write: if rgIsSuper() || rgCanManageStaff(groupId);
      }
      // ── Messaging / notifications ──
      // Notifications (Job 6f): reads stay group-member (the bell feed). SENDING is
      // enforced here, not just by the hidden sidebar item:
      //   - authored/broadcast docs (type "custom" — the Notifications page + the
      //     scheduler's sends) require rgCanSendNotifications;
      //   - NON-custom types stay member-writable: system alert side-channels write
      //     client-side fire-and-forget (temperature out-of-range, checklist notifies)
      //     from staff-tier users, and blocking those breaks real alerts. Stated
      //     boundary: a member could forge a non-custom-typed doc — the authored
      //     broadcast path is what this rule enforces.
      //   - members may update ONLY readBy (read receipts); senders may edit/delete.
      // notificationsArchive (6e) deliberately has NO match — client reads are denied;
      // only the Admin-SDK cleanup function touches it.
      match /notifications/{notificationId} {
        allow read: if rgIsSuper() || rgIsGroupMember(groupId);
        allow create: if rgIsSuper() || rgCanSendNotifications(groupId)
          || (rgIsGroupMember(groupId) && request.resource.data.get('type', '') != 'custom');
        allow update: if rgIsSuper() || rgCanSendNotifications(groupId)
          || (rgIsGroupMember(groupId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
        allow delete: if rgIsSuper() || rgCanSendNotifications(groupId);
      }
      // Scheduled notifications (6c): authoring surface for senders only — read AND write
      // (the schedules list itself reveals what management broadcasts, so no member read).
      match /scheduledNotifications/{schedId} {
        allow read, write: if rgIsSuper() || rgCanSendNotifications(groupId);
      }
      // Group-chat conversations (Job 5) — MEMBER-ONLY, WhatsApp-like. The doc carries
      // memberUids[] (Firebase auth uids); only listed members read it, so both apps
      // query with where("memberUids","array-contains",uid). Legacy docs without the
      // field become invisible — run scripts/backfill-conversation-uids.js once.
      // Member edits: owner/storeAdmin, or a member holding messages == 'approve'.
      match /conversations/{conversationId} {
        allow read:   if rgIsSuper() || (rgIsGroupMember(groupId) && request.auth.uid in resource.data.get('memberUids', []));
        allow create: if rgIsSuper() || (rgIsGroupMember(groupId) && request.auth.uid in request.resource.data.get('memberUids', []));
        allow update: if rgIsSuper() || rgIsGroupAdmin(groupId)
          || (rgIsGroupMember(groupId) && request.auth.uid in resource.data.get('memberUids', []) && rgCanEditChatMembers(groupId));
        allow delete: if rgIsSuper() || rgIsGroupAdmin(groupId);
      }
      match /auditLog/{docId}      { allow read, write: if rgIsSuper() || rgIsGroupMember(groupId); }
      match /announcements/{docId} { allow read, write: if rgIsSuper() || rgIsGroupMember(groupId); }
      // Messages: SENDING into a group chat (conv "grp_<docId>") requires membership of
      // that conversation. READS stay group-member-wide: both apps still list the flat
      // collection for DM discovery/unread badges, and a per-doc read condition would
      // deny those whole-collection listeners outright. This is a stated UX boundary,
      // not full enforcement — a determined member can still read grp_ messages
      // directly. Closing it needs the per-conversation listener restructure in BOTH
      // apps (RGContext badges + Messaging screens) as its own change.
      match /messages/{docId} {
        allow read: if rgIsSuper() || rgIsGroupMember(groupId);
        allow create: if rgIsSuper() || (rgIsGroupMember(groupId)
          && (!request.resource.data.get('conv', '').matches('^grp_.+')
              || request.auth.uid in get(/databases/$(database)/documents/restaurantGroups/$(groupId)/conversations/$(request.resource.data.conv.split('grp_')[1])).data.get('memberUids', [])));
        allow update, delete: if rgIsSuper() || rgIsGroupMember(groupId);
      }
      // ── Help cards ("How to use MyMor") — short read-only guides for staff.
      // Read: any group member (staff read these during onboarding). Write:
      // owner/storeAdmin only (edited in Admin web; content, not HR data).
      match /helpCards/{cardId} {
        allow read:  if rgIsSuper() || rgIsGroupMember(groupId);
        allow write: if rgIsSuper() || rgIsGroupAdmin(groupId);
      }
    }

    match /hostel/{hid} {
      allow read:           if isSignedIn() && request.auth.token.role == 'superadmin';
      allow create, update: if isSignedIn() && (request.auth.token.role == 'superadmin' || request.auth.token.type == 'superadmin');
      allow delete:         if isSignedIn() && (request.auth.token.role == 'superadmin' || resource.data.adminUID == null);
    }
    match /adminMenuState/{uid}/menus/{menuKey} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

      match /employees/{empId} {
      allow read, write: if isSignedIn() && userHostelId() != null
        && resource.data.hostelid == userHostelId()
        && hostelActive(userHostelId());
      allow read:   if isSignedIn() && request.auth.uid == empId;
      // ⬅ CHANGED: rgCanManageStaff includes 'manager', so a manager could mint a NEW
      // employees doc with groupRole:'owner' for their own group — full escalation.
      // The only legitimate owner-create is the superadmin group-creation flow, which
      // rides rgIsSuper() above. StaffDirectory's createAdminLogin uses roleToGroupRole(),
      // which tops out at 'storeAdmin', so the one real client create is unaffected.
      allow create: if rgIsSuper()
        || (rgCanManageStaff(request.resource.data.groupId)
            && request.resource.data.get('groupRole', 'staff') != 'owner');
      // ⬅ CHANGED: same escalation via update — a manager could rewrite their OWN doc to
      // groupRole:'owner'. In the whole rg product there is exactly ONE client update to
      // employees (UserManagementPage, writing `permissions` only, gated usermgmt:edit =
      // owner/storeAdmin). groupRole is never updated from a client anywhere. So: restricted
      // to owner/storeAdmin, with a key whitelist that excludes groupRole and type.
      allow update: if rgIsSuper()
        || (rgIsGroupAdmin(resource.data.groupId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['permissions', 'venueId', 'venueIds', 'isActive', 'status', 'name', 'updatedAt']));
    }
    match /users/{uid} {
      allow read, write: if isSignedIn() && userHostelId() != null
        && resource.data.hostelid == userHostelId()
        && hostelActive(userHostelId());
      allow read:   if isSignedIn() && request.auth.uid == uid;
      allow create: if rgIsSuper() || rgCanManageStaff(request.resource.data.groupId);
      allow update: if rgIsSuper() || rgCanManageStaff(resource.data.groupId) || request.auth.uid == uid;
    }

    // Locked: confirmed unused by every app/function (real verification runs
    // through Cloud Functions writing emailOtps via the Admin SDK).
    match /emailVerifications/{email} { allow read, write: if false; }
    // OTP collections are written/read ONLY by Cloud Functions (Admin SDK, which
    // bypasses rules). Deny all client access so email + code hash aren't exposed
    // to signed-in users via the bottom catch-all.
    match /emailOtps/{id}         { allow read, write: if false; }
    match /passwordResetOtps/{id} { allow read, write: if false; }
     match /events/{eventId}           { allow read: if request.auth != null; }
    match /eventBookings/{docId}      { allow read: if request.auth != null && request.auth.uid == resource.data.userId; }
    match /User/{userId}              { allow read: if request.auth.uid == userId; }
    match /eventcategory/{docId}      { allow read: if true; }
    match /University/{document}      { allow read:  if true; allow write: if isSignedIn(); }
    match /discoverfile/{uid}/{allPaths=**} { allow write: if request.auth.uid == uid; }
    match /{coll}/{rest=**} {
      allow read, write: if isSignedIn() && coll != 'restaurantGroups' && !rgIsGroupUser();
    }
    // FCM push tokens (rgPushOnNotification reads these via the Admin SDK; the apps
    // write their own on login — MyMorOps src/lib/push.js). Own-uid only. NOTE: the
    // catch-all above denies rg-group users, so this explicit grant is what lets the
    // Ops iPad save its token.
    match /userTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}